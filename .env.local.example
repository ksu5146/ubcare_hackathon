# 공공데이터포털 (data.go.kr) 서비스키 (인코딩된 키)
DATA_GO_KR_API_KEY=YOUR_DATA_GO_KR_API_KEY_HERE

# 카카오 REST API 키 (서버 사이드 전용)
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY_HERE

# 카카오 JS SDK 앱 키 (클라이언트 사이드 — 지도 컴포넌트에서 사용)
NEXT_PUBLIC_KAKAO_MAP_KEY=YOUR_KAKAO_JS_APP_KEY_HERE

# ODsay 대중교통 API 키 (클라이언트 사이드 — 브라우저에서 직접 호출)
NEXT_PUBLIC_ODSAY_API_KEY=YOUR_ODSAY_API_KEY_HERE
